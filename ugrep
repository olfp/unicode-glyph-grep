#!/usr/bin/env python3
"""Search ordinary text in files containing Unicode mathematical glyphs.

NFKC normalization makes patterns such as ``proc`` match ``𝐩𝐫𝐨𝐜`` while
matching lines are printed in their original form.
"""

from __future__ import annotations

import argparse
import re
import sys
import unicodedata
from pathlib import Path


def normalize_for_search(text: str) -> str:
    return unicodedata.normalize("NFKC", text)


def contains_unicode_glyph(text: str) -> bool:
    """Return True if text contains mathematical alphanumeric glyphs."""
    for ch in text:
        code = ord(ch)
        if 0x1D400 <= code <= 0x1D7FF:
            return True
        if ch in {"ℎ", "ℏ"}:
            return True
    return False


def search_files(
    paths,
    pattern,
    *,
    ignore_case=False,
    invert=False,
    line_numbers=False,
    quiet=False,
    with_filename=False,
    no_filename=False,
    count_matches=False,
    max_count=None,
    recursive=False,
    unicode_mode=False,
    probe_lines=100,
):
    flags = re.IGNORECASE if ignore_case else 0
    regex = re.compile(pattern, flags)
    file_list = []
    stdin_requested = False

    for path in paths:
        if path == "-":
            stdin_requested = True
            continue

        candidate = Path(path)
        if candidate.is_dir():
            if recursive:
                file_list.extend(sorted(p for p in candidate.rglob("*") if p.is_file()))
            elif candidate.is_file():
                file_list.append(candidate)
        elif candidate.is_file():
            file_list.append(candidate)

    if stdin_requested:
        file_list.append(Path("-"))

    matched_any = False
    multiple_files = len(file_list) > 1

    for file_path in file_list:
        local_matches = 0
        if file_path == Path("-"):
            handle = sys.stdin
            use_unicode = unicode_mode
            if not use_unicode:
                # We cannot rewind stdin, so only the current implementation can
                # make a best effort by normalizing the data it sees in stream.
                use_unicode = True
            file_lines = []
            for raw_line in handle:
                file_lines.append(raw_line.rstrip("\n"))
            stream_lines = file_lines
        else:
            with open(file_path, "r", encoding="utf-8", errors="surrogateescape") as handle:
                file_lines = handle.readlines()
            stream_lines = file_lines
            use_unicode = unicode_mode or any(
                contains_unicode_glyph("\n".join(file_lines[:probe_lines]))
            )

        if not use_unicode:
            # Fall back to plain grep semantics for ASCII-only files.
            import subprocess
            try:
                subprocess.run(["grep", *([] if not ignore_case else ["-i"]), pattern, str(file_path)],
                               check=False)
            except FileNotFoundError:
                pass
            continue

        for lineno, line in enumerate(stream_lines, 1):
            normalized = normalize_for_search(line)
            matched = bool(regex.search(normalized))
            if invert:
                matched = not matched
            if not matched:
                continue

            local_matches += 1
            matched_any = True

            if max_count is not None and local_matches > max_count:
                break

            if count_matches or quiet:
                continue

            prefix = f"{lineno}:" if line_numbers else ""
            filename_prefix = ""
            if with_filename:
                filename_prefix = f"{file_path}:"
            elif multiple_files and file_path != Path("-"):
                filename_prefix = f"{file_path}:"
            if no_filename:
                filename_prefix = ""

            print(f"{filename_prefix}{prefix}{line}")

        if count_matches:
            if with_filename or (multiple_files and file_path != Path("-") ):
                print(f"{file_path}:{local_matches}")
            else:
                print(local_matches)

    return 0 if matched_any else 1


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Search ASCII patterns in Unicode mathematical glyph source."
    )
    parser.add_argument("pattern", nargs="?", help="Regular expression to search for")
    parser.add_argument("paths", nargs="*", help="Files or directories; default: stdin")
    parser.add_argument("-e", "--regexp", help="Pattern supplied separately")
    parser.add_argument("-i", "--ignore-case", action="store_true")
    parser.add_argument("-n", "--line-number", action="store_true")
    parser.add_argument("-q", "--quiet", action="store_true")
    parser.add_argument("-r", "--recursive", action="store_true",
                        help="Recursively search directories")
    parser.add_argument("-v", "--invert-match", action="store_true")
    parser.add_argument("-H", "--with-filename", action="store_true",
                        help="Print file name with matches even for a single file")
    parser.add_argument("-h", "--no-filename", action="store_true",
                        help="Suppress filename prefixing")
    parser.add_argument("-c", "--count", action="store_true",
                        help="Count matching lines instead of printing them")
    parser.add_argument("-m", "--max-count", type=int,
                        help="Stop after N matches per file")
    parser.add_argument("-u", "--unicode", action="store_true",
                        help="Force Unicode glyph mode even when the file looks ASCII-only")
    parser.add_argument("--probe-lines", type=int, default=100,
                        help="Number of initial lines to inspect for Unicode glyphs")
    args = parser.parse_args(argv)

    if args.with_filename and args.no_filename:
        parser.error("-H/--with-filename and -h/--no-filename cannot be used together")

    pattern = args.regexp if args.regexp is not None else args.pattern
    if pattern is None:
        parser.error("a pattern is required")

    paths = args.paths or ["-"]
    return search_files(
        paths,
        pattern,
        ignore_case=args.ignore_case,
        invert=args.invert_match,
        line_numbers=args.line_number,
        quiet=args.quiet,
        with_filename=args.with_filename,
        no_filename=args.no_filename,
        count_matches=args.count,
        max_count=args.max_count,
        recursive=args.recursive,
        unicode_mode=args.unicode,
        probe_lines=args.probe_lines,
    )


if __name__ == "__main__":
    raise SystemExit(main())
