#!/usr/bin/env python3
"""grep-compatible search with Unicode mathematical-glyph matching."""
from __future__ import annotations

import argparse
import configparser
import re
import shutil
import subprocess
import sys
import unicodedata
from pathlib import Path

DEFAULT_PROBE_LINES = 100
DEFAULT_GREP = "/usr/bin/grep"


def normalize_for_search(text: str) -> str:
    return unicodedata.normalize("NFKC", text)


def contains_unicode_glyph(text: str) -> bool:
    return any(0x1D400 <= ord(c) <= 0x1D7FF or c in {"ℎ", "ℏ"} for c in text)


def read_config(path=None):
    candidates = [path] if path else [Path.cwd() / ".ugreprc", Path.home() / ".ugreprc"]
    parser = configparser.ConfigParser()
    for candidate in candidates:
        if candidate and candidate.is_file():
            parser.read(candidate, encoding="utf-8")
            section = parser["ugrep"] if parser.has_section("ugrep") else parser.defaults()
            return dict(section.items())
    return {}


def grep_program(config):
    configured = config.get("grep", DEFAULT_GREP)
    if Path(configured).is_file() and Path(configured).stat().st_mode & 0o111:
        return configured
    found = shutil.which(configured)
    if found:
        return found
    return DEFAULT_GREP


def remove_ugrep_options(argv):
    result = []
    skip = False
    for arg in argv:
        if skip:
            skip = False
            continue
        if arg in {"-u", "--unicode", "-t", "--no-unicode"}:
            continue
        if arg in {"--probe-lines", "--config"}:
            skip = True
            continue
        if arg.startswith("--probe-lines=") or arg.startswith("--config="):
            continue
        result.append(arg)
    return result


def run_system_grep(argv, input_text, config):
    return subprocess.run(
        [grep_program(config), *remove_ugrep_options(argv)],
        input=input_text,
        text=True,
    ).returncode


def search_lines(lines, regex, args, filename=None, multiple_files=False):
    matched_any = False
    count = 0
    for lineno, line in enumerate(lines, 1):
        matched = bool(regex.search(normalize_for_search(line)))
        if args.invert_match:
            matched = not matched
        if not matched:
            continue
        count += 1
        matched_any = True
        if args.max_count is not None and count > args.max_count:
            break
        if args.count or args.quiet:
            continue
        prefix = ""
        if not args.no_filename and (args.with_filename or (multiple_files and filename)):
            prefix += f"{filename}:"
        if args.line_number:
            prefix += f"{lineno}:"
        print(f"{prefix}{line}")
    if args.count:
        prefix = f"{filename}:" if filename and not args.no_filename and (args.with_filename or multiple_files) else ""
        print(f"{prefix}{count}")
    return matched_any


def main(argv=None):
    raw = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(
        description="Search ASCII patterns in Unicode mathematical-glyph source.",
        add_help=False,
    )
    parser.add_argument("--help", action="help", help="show this help message and exit")
    parser.add_argument("pattern", nargs="?")
    parser.add_argument("paths", nargs="*")
    parser.add_argument("-e", "--regexp")
    parser.add_argument("-i", "--ignore-case", action="store_true")
    parser.add_argument("-n", "--line-number", action="store_true", help="print line numbers")
    parser.add_argument("-q", "--quiet", action="store_true")
    parser.add_argument("-r", "--recursive", action="store_true")
    parser.add_argument("-v", "--invert-match", action="store_true")
    parser.add_argument("-H", "--with-filename", action="store_true")
    parser.add_argument("-h", "--no-filename", action="store_true", help="suppress filename prefixes")
    parser.add_argument("-c", "--count", action="store_true")
    parser.add_argument("-m", "--max-count", type=int)
    parser.add_argument("-u", "--unicode", action="store_true", help="force Unicode normalization mode")
    parser.add_argument("-t", "--no-unicode", action="store_true", help="force the real system grep")
    parser.add_argument("--probe-lines", type=int, help="number of initial lines to inspect")
    parser.add_argument("--config", type=Path, help="read this .ugreprc instead of the defaults")
    args, unknown = parser.parse_known_args(raw)

    if args.with_filename and args.no_filename:
        parser.error("-H and -h cannot be used together")
    if args.unicode and args.no_unicode:
        parser.error("-u and -t cannot be used together")
    if unknown and args.unicode:
        parser.error("unrecognized arguments in Unicode mode: " + " ".join(unknown))

    config = read_config(args.config)
    try:
        probe_lines = args.probe_lines if args.probe_lines is not None else int(config.get("probe_lines", DEFAULT_PROBE_LINES))
    except ValueError:
        parser.error("probe_lines in .ugreprc must be an integer")
    if probe_lines < 1:
        parser.error("--probe-lines must be at least 1")

    pattern = args.regexp if args.regexp is not None else args.pattern
    if pattern is None:
        parser.error("a pattern is required")
    paths = args.paths or ["-"]

    if args.no_unicode:
        return run_system_grep(raw, None, config)

    files = []
    stdin_requested = False
    for value in paths:
        if value == "-":
            stdin_requested = True
            continue
        path = Path(value)
        if path.is_dir() and args.recursive:
            files.extend(sorted(p for p in path.rglob("*") if p.is_file()))
        elif path.is_file():
            files.append(path)

    flags = re.IGNORECASE if args.ignore_case else 0
    regex = re.compile(pattern, flags)
    if stdin_requested or not files:
        data = sys.stdin.read()
        use_unicode = args.unicode or contains_unicode_glyph("\n".join(data.splitlines()[:probe_lines]))
        if not use_unicode:
            return run_system_grep(raw, data, config)
        return 0 if search_lines(data.splitlines(), regex, args) else 1

    multiple_files = len(files) > 1
    overall_match = False
    for path in files:
        with path.open("r", encoding="utf-8", errors="surrogateescape") as handle:
            lines = handle.readlines()
        use_unicode = args.unicode or contains_unicode_glyph("\n".join(line.rstrip("\n") for line in lines[:probe_lines]))
        if use_unicode:
            if search_lines((line.rstrip("\n") for line in lines), regex, args, str(path), multiple_files):
                overall_match = True
        else:
            delegated = run_system_grep(raw + ([] if str(path) in raw else [str(path)]), None, config)
            if delegated == 0:
                overall_match = True
    return 0 if overall_match else 1


if __name__ == "__main__":
    raise SystemExit(main())
